FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64 AS builder

WORKDIR /app
RUN python -m venv /opt/venv
COPY pyproject.toml README.md /app/
RUN /opt/venv/bin/pip install --no-cache-dir \
    "cryptography>=45,<47" \
    "psycopg[binary]>=3.2,<4" \
    "pyjwt>=2.10,<3" \
    "sqlglot>=26,<27" \
    "uvicorn[standard]>=0.34,<1"

FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64

WORKDIR /app
RUN groupadd --system --gid 10001 appgroup && \
    useradd --system --uid 10001 --gid appgroup --home-dir /app \
      --shell /usr/sbin/nologin appuser
COPY --from=builder /opt/venv /opt/venv
COPY packages /app/packages
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/packages/execution_kernel:/app/packages/task_runtime:/app/packages/approval_plane:/app/packages/governance:/app/packages/memory_service:/app/packages/connector_execution:/app/packages/control_api:/app/packages/read_workflows:/app/packages/workflow_reliability:/app/packages/semantic_catalog:/app/packages/governed_orchestrator"
USER appuser
EXPOSE 8000
CMD ["uvicorn", "control_api.server:app", "--host", "0.0.0.0", "--port", "8000"]
